C {title.sym} 170 -40 0 0 {name=l1 author="Timonas Juonys"}
C {lab_pin.sym} 260 -1080 3 1 {name=p2 sig_type=std_logic lab=o10}
C {lab_pin.sym} 150 -1080 0 0 {name=p6 sig_type=std_logic lab=in}
C {code_shown.sym} 16.74901121701339 -861.7671459816082 0 0 {name=s1 only_toplevel=false value="
.global VDD GND BP BN
.option temp=27
.include /usr/local/share/pdk/gf180mcuC/libs.tech/ngspice/design.ngspice
.lib /usr/local/share/pdk/gf180mcuC/libs.tech/ngspice/sm141064.ngspice typical

Vdd VDD 0 3.3
Vdd2 VDD2 0 1.67
Vbp BP VDD 2.7
Vbn BN GND -2.7
Vin in 0 PWL(0 0 100n 3.3)
Vind ind 0 PWL(0 0 49.9n 0 50.1n 1.425 99.9n 1.425 100.1n 3.3 149.9n 3.3 150.1n 1.425 199.9n 1.425 200.1n 0 250n 0)

.control
  save all
  tran 0.05n 250n
  meas tran t_cross WHEN v(o5d)=1.25 CROSS=1
  meas tran t_cross WHEN v(o6d)=1.25 CROSS=1
  meas tran t_cross WHEN v(o7d)=1.25 CROSS=1
  meas tran t_cross WHEN v(o8d)=1.25 CROSS=1
  meas tran t_cross WHEN v(o9d)=1.25 CROSS=1
  write STI_TB.raw
.endc
.end
"}
