C {lab_pin.sym} 170 -1010 0 0 {name=p7 sig_type=std_logic lab=GND}
C {launcher.sym} 2010 -140 0 0 {name=h5
descr="load waves"
tclcommand="xschem raw_read $netlist_dir/STI_TB.raw tran"
}
