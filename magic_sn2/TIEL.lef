VERSION 5.7 ;
  NOWIREEXTENSIONATPIN ON ;
  DIVIDERCHAR "/" ;
  BUSBITCHARS "[]" ;
MACRO TIEL
  CLASS core ;
  FOREIGN TIEL ;
  ORIGIN 0.000 0.000 ;
  SIZE 1.680 BY 4.480 ;
  SITE site056um ;
  PIN VSS
    DIRECTION INOUT ;
    USE GROUND ;
    PORT
      LAYER Metal1 ;
        RECT 0.000 -0.140 1.680 0.140 ;
    END
  END VSS
  PIN VDD
    DIRECTION INOUT ;
    USE POWER ;
    PORT
      LAYER Metal1 ;
        RECT 0.000 4.340 1.680 4.620 ;
    END
  END VDD
  PIN Z
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    ANTENNADIFFAREA 0.151600 ;
    PORT
      LAYER Metal1 ;
        RECT 1.260 0.420 1.540 1.260 ;
    END
  END Z
  OBS
      LAYER Nwell ;
        RECT -0.170 3.160 1.890 4.755 ;
        RECT 0.000 2.560 1.680 3.160 ;
        RECT -0.150 1.260 1.975 2.560 ;
        RECT 0.000 1.135 1.680 1.260 ;
      LAYER Pwell ;
        RECT -0.255 -0.190 1.830 1.135 ;
      LAYER Metal1 ;
        RECT 0.370 1.560 1.550 4.040 ;
        RECT 0.370 0.440 0.960 1.560 ;
  END
END TIEL
END LIBRARY

