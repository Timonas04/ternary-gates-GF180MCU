VERSION 5.7 ;
  NOWIREEXTENSIONATPIN ON ;
  DIVIDERCHAR "/" ;
  BUSBITCHARS "[]" ;
MACRO TIEH
  CLASS core ;
  FOREIGN TIEH ;
  ORIGIN 0.000 0.000 ;
  SIZE 1.680 BY 4.480 ;
  SITE site056um ;
  PIN VSS
    DIRECTION INOUT ;
    USE GROUND ;
    PORT
      LAYER Metal1 ;
        RECT 0.000 -0.140 1.680 0.140 ;
    END
  END VSS
  PIN VDD
    DIRECTION INOUT ;
    USE POWER ;
    PORT
      LAYER Metal1 ;
        RECT 0.000 4.340 1.680 4.620 ;
    END
  END VDD
  PIN Z
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    ANTENNADIFFAREA 0.195800 ;
    PORT
      LAYER Metal1 ;
        RECT 1.400 1.540 1.680 2.380 ;
    END
  END Z
  OBS
      LAYER Nwell ;
        RECT -0.030 3.160 1.830 4.755 ;
        RECT 0.000 2.560 1.680 3.160 ;
        RECT -0.010 1.260 2.115 2.560 ;
        RECT 0.000 1.135 1.680 1.260 ;
      LAYER Pwell ;
        RECT -0.115 -0.190 1.830 1.135 ;
      LAYER Metal1 ;
        RECT 0.510 2.680 1.680 4.040 ;
        RECT 0.510 1.240 1.100 2.680 ;
        RECT 0.510 0.600 1.680 1.240 ;
        RECT 0.510 0.440 1.690 0.600 ;
        RECT 1.635 0.370 1.690 0.440 ;
  END
END TIEH
END LIBRARY

